# ==============================================================================
# Supabase Cloud Database Configuration for VeriSpect
# ==============================================================================
# 1. Create a free project at https://supabase.com
# 2. Run the SQL schema from "supabase_schema.sql" in the Supabase SQL Editor
# 3. Copy your Project URL & API Key from Project Settings -> API
# 4. Set these variables in Vercel (Project Settings -> Environment Variables)
#    or in your local .env file
# ==============================================================================

SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Service role key for elevated backend operations
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here
